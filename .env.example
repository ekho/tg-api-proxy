# Docker Compose reads .env; the Go application itself does not load it.
# All settings below require container recreation after a change.
PROXY_PORT=8080
LONG_POLL_MAX_TIMEOUT=45
LOG_EXCLUDE_METHODS=getUpdates

# Optional outgoing proxy; empty means connect directly to Telegram.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=

# Optional OpenTelemetry collector. JSON access logs work without it.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_RESOURCE_ATTRIBUTES=

# For a native run only; Compose fixes this to /config/config.yaml.
# CONFIG_FILE=config.yaml
# PORT=8080
